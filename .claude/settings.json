{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(python tools/:*)",
      "Bash(python -m pytest:*)",
      "PowerShell(.\\server\\scripts\\boot-test.ps1:*)",
      "PowerShell(.\\server\\scripts\\assemble-server.ps1:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)"
    ]
  }
}
