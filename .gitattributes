# Line endings: LF in the repository and on checkout regardless of core.autocrlf.
# Minecraft/Fabric tooling and Linux servers expect LF; Windows scripts get CRLF.
* text=auto eol=lf
*.json        text eol=lf
*.json5       text eol=lf
*.mcfunction  text eol=lf
*.mcmeta      text eol=lf
*.toml        text eol=lf
*.properties  text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.py          text eol=lf
*.sh          text eol=lf
*.ps1         text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf

# Binaries: never diff, never convert
*.jar       binary
*.zip       binary
*.mrpack    binary
*.nbt       binary
*.schem     binary
*.schematic binary
*.litematic binary
*.dat       binary
*.db        binary
*.png       binary
*.ogg       binary
*.pdf       binary

# Large world sources: opt in to Git LFS only if we decide to keep them in-repo
*.world filter=lfs diff=lfs merge=lfs -text
