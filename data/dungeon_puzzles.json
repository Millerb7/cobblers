    "hint_levers": "Match the lamps.",
    "hint_sequence": "",
    "hint_plates": "",
    "hint_vault": "Each chest: {s} s.",
    "chest_taken": "-{s} s.",
    "wrong_levers": "-{s} s.",
    "wrong_sequence": "-{s} s.",
    "wrong_plates": "-{s} s."
  },
