  "gym_markers": {
    "why": "NAVIGATION.md section 6, one gym ahead: when gymN_cleared is granted the player is offered a Xaero's waypoint to the next gym, by a chat share they accept with a click. Gym 1's is Oak's to offer at the start (not built). The waypoint points at the middle of the gym building's placed footprint (tools/place_donor.py box). Replaces Cobbleverse's gym maps, which point at naturally generated gyms this world does not have.",
    "share_format": "xaero-waypoint:<name>:<initials>:<x>:<y or ~>:<z>:<color>:<rotation>:<yaw>:Internal-overworld-waypoints, read from xaerominimap-fabric-1.21.1-26.4.2 WaypointSharingHandler (name 1-32 characters, initials 1-3, no '-', '_' or ':')",
    "color": 14,
    "markers": {
      "gym2_town": {
