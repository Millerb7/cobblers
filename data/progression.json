  "upstream_neutralised": {
    "why": "Overrides at the upstream paths, deliberately (.claude/rules/datapacks.md). The four loot tables are exploration maps to Cobbleverse's naturally generated gyms, which this world does not generate: cobbleverse:gym_map is the reward of Cobbleverse's cobblemon:craft_pokedex (the first Pokedex a player holds), and the Johto, Hoenn and Sinnoh ones reward the previous region's Champion. They become empty. The reward functions are named by Cobbleverse's leader, Elite Four and Champion advancements (cobbleverse:trainer/*/defeat_*) and exist in no installed pack (checked 2026-09-21 across every pack and jar on the server); an empty function of each name means the advancement grants cleanly.",
    "empty_loot_tables": ["cobbleverse:gym_map", "cobbleverse:johto_gym_map", "cobbleverse:hoenn_gym_map", "cobbleverse:sinnoh_gym_map"],
    "empty_functions": ["cobbleverse:aaron_defeated", "cobbleverse:adriano_defeated", "cobbleverse:agatha_defeated", "cobbleverse:alfredo_defeated", "cobbleverse:alice_defeated", "cobbleverse:angelo_defeated", "cobbleverse:bianca_defeated", "cobbleverse:blaine_defeated", "cobbleverse:brock_defeated", "cobbleverse:bruno_defeated", "cobbleverse:bruno_johto_defeated", "cobbleverse:chiara_defeated", "cobbleverse:corrado_defeated", "cobbleverse:cyrus_defeated", "cobbleverse:drake_defeated", "cobbleverse:erika_defeated", "cobbleverse:ester_defeated", "cobbleverse:fannie_defeated", "cobbleverse:ferruccio_defeated", "cobbleverse:fiammetta_defeated", "cobbleverse:fosco_defeated", "cobbleverse:frida_defeated", "cobbleverse:furio_defeated", "cobbleverse:gardenia_defeated", "cobbleverse:giovanni_defeated", "cobbleverse:jasmine_defeated", "cobbleverse:jupiter_defeated", "cobbleverse:karen_defeated", "cobbleverse:koga_defeated", "cobbleverse:koga_johto_defeated", "cobbleverse:lance_defeated", "cobbleverse:lorelei_defeated", "cobbleverse:ltsurge_defeated", "cobbleverse:luciano_defeated", "cobbleverse:mars_defeated", "cobbleverse:marzia_defeated", "cobbleverse:misty_defeated", "cobbleverse:norman_defeated", "cobbleverse:omar_defeated", "cobbleverse:pedro_defeated", "cobbleverse:petra_defeated", "cobbleverse:pino_defeated", "cobbleverse:raffaello_defeated", "cobbleverse:rudi_defeated", "cobbleverse:sabrina_defeated", "cobbleverse:sandra_defeated", "cobbleverse:saturn_defeated", "cobbleverse:tell_defeated", "cobbleverse:terrie_defeated", "cobbleverse:valerio_defeated", "cobbleverse:vulcano_defeated", "cobbleverse:walter_defeated"]
