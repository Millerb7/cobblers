{
  "schema": "cobblers.quests/1",
  "status": "proposed",
  "state_model": {
    "authoritative_source": "data/progression.json",
    "rule": "Quest definitions contain no mutable quest-local state. Every condition and transition reads or writes a typed field in the campaign progression registry.",
    "default_scope": "player",
    "supported_scopes": [
      "player",
      "world"
    ],
    "excluded_scope": "party",
    "excluded_scope_reason": "The current runtime has no authoritative party membership, shared checkpoint, lock, recovery, or group-reward service.",
    "field_types": [
      "boolean",
      "enum",
      "integer"
    ],
    "quest_field_namespace": "quest.<quest_id>.<field>",
    "quest_scope_modes": [
      "player",
      "world",
      "mixed"
    ]
  },
  "schema_definition": {
    "quest_required": [
      "id",
      "source",
      "scope",
      "optional",
      "progression_field_refs",
      "availability",
      "objectives",
      "transitions",
      "multiplayer"
    ],
    "transition_required": [
      "id",
      "conditions",
      "effects"
    ],
    "condition_kinds": [
      "all",
      "any",
      "held_item",
      "inventory_contains",
      "not",
      "progression_equals",
      "progression_in"
    ],
    "effect_kinds": [
      "compare_and_set_progression",
      "consume_held_item",
      "give_item",
      "grant_reward_once",
      "relocate_actor",
      "set_progression"
    ],
    "transaction_rule": "Progression writes and inventory changes in a transition commit atomically for the triggering player. grant_reward_once must durably commit its per-player claim receipt with item delivery. World compare-and-set and actor relocation are idempotent and retryable; they are not represented as one cross-scope transaction.",
    "progression_registration_rule": "Every progression_field_refs id must be declared exactly once in data/progression.json quest_fields. That registry is authoritative for type, scope, initial value, and allowed values.",
    "mixed_scope_rule": "A mixed quest declares scope per progression field. World effects use an idempotent compare-and-set transition; rewards and dialogue cursors remain per player."
  },
  "design_decisions": [
    {
      "id": "gastly_escort_scope",
      "decision": "per_player_checkpoint_escort",
      "reason": "One optional side quest does not justify introducing a shared-party state service into every quest schema.",
      "retained_infrastructure": [
        "player-owned Gastly actor binding",
        "per-player proximity checks",
        "per-player checkpoint progression",
        "repositioning at the last checkpoint after reconnect or restart",
        "per-player reward claim"
      ],
      "removed_infrastructure": [
        "party membership and leader identity",
        "shared checkpoint ownership",
        "atomic transitions across several players",
        "leader disconnect handoff",
        "late-join party reconciliation",
        "group reward fan-out and eligibility snapshots",
        "shared battle locking"
      ],
      "experience_cost": [
        "Friends no longer complete one authoritative family rescue together.",
        "Players standing together may see separate Gastly actors or different checkpoint states.",
        "A player joining midway must start or resume their own escort rather than inherit a friend's progress."
      ]
    }
  ],
