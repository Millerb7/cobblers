# server.properties.example - private Cobblemon campaign server
# Copy to <serverdir>/server.properties. The live file is NOT tracked (it may
# hold rcon.password). Lines starting with '#' are comments; Minecraft rewrites
# the file on boot and drops them, so keep this example as the documented copy.

# --- identity / access --------------------------------------------------
motd=Cobblers private campaign
# online-mode=true: Mojang authentication. Keep true on any internet-reachable
# server; it is what makes whitelist/ops UUIDs mean anything.
online-mode=true
# Friends-only server: whitelist on, enforce so removed players get kicked.
white-list=true
enforce-whitelist=true
max-players=8
server-port=25565
# RCON is off by default. Turn it on when the server is launched in the
# background, because then it has no reachable stdin: without RCON the only
# way to stop it is to kill the process, which skips the world save. It is
# also the only way to run Distant Horizons' `dh pregen`.
#
# If you enable it: bind to localhost, set a real password in the LIVE file
# only and never here, and put that password in a .rcon-password file beside
# server/scripts/rcon.py (gitignored). Then:
#   python server/scripts/rcon.py "dh pregen start overworld 4096 4096 256"
#   python server/scripts/rcon.py "tick query"
#   python server/scripts/rcon.py stop
enable-rcon=false
# rcon.port=25575
enable-query=false
enable-status=true

# --- gameplay ------------------------------------------------------------
# Campaign difficulty comes from trainers and level caps, not from vanilla
# mobs, but 'hard' keeps the overworld from being trivial.
difficulty=hard
gamemode=survival
force-gamemode=false
hardcore=false
pvp=false
allow-flight=true
# Spawn protection blocks building near spawn for non-ops; we build the hub
# ourselves, so 0.
spawn-protection=0
# Level type is set by the pack (Terralith datapack etc.); leave default and
# let datapacks/worldgen decide. Set level-seed deliberately when the campaign
# world is generated and record it in docs/, not here.
level-name=world
level-seed=
allow-nether=true
generate-structures=true
spawn-monsters=true
spawn-npcs=true
spawn-animals=true
max-world-size=29999984

# --- performance ---------------------------------------------------------
# These two are independent and are priced very differently.
#
# simulation-distance drives entity ticking, mob AI, redstone and block
# updates. It is the expensive one, and with Cobblemon spawning a lot of
# entities it is the number that decides server tick time. 6 is deliberate.
#
# view-distance only decides which chunks are sent to a client. Distant
# Horizons renders everything past roughly 160 blocks from its own LOD data,
# so a low vanilla view distance costs nothing visually. Do not raise this
# above 12; if DH is doing its job, test whether 8 is enough once LOD is
# populated and lower it further.
view-distance=10
simulation-distance=6
max-tick-time=60000
network-compression-threshold=256
# Cobblemon keeps many entities loaded. Lower this toward 50 if player
# connections show network pressure; it shrinks how far entity updates are
# broadcast without touching what players can see of the terrain.
entity-broadcast-range-percentage=100
sync-chunk-writes=true

# --- pack / resources ----------------------------------------------------
# The server delivers one client pack (ADR-006, Proposed):
# build/client/cobblers-client-AllTheMons-subset.zip, built by
#   python tools/client_model_fix.py build --server-pack --instance <client instance>
# It gives the 43 doll species their AllTheMons models (Flutter Mane, Iron
# Valiant, Vullaby, Greavard...) and restores Cobblemon 1.8's own files for the
# mis-assembled and crash forms. The pack is never committed.
#
# LICENCE GATE: the AllTheMons files in it are under ALLTHEMONS LICENSE v3.2,
# whose section 1.3 allows uploading copies "only with explicit written
# permission". Do not host the zip or fill resource-pack until Lvnatic's written
# permission is on record (docs/decisions/ADR-006-server-delivered-client-pack.md).
#
# resource-pack: the HTTPS direct-download URL of the hosted zip, reachable
# without login. Empty means the server delivers no pack; it stays empty here
# because the URL is the owner's hosting choice (server/README.md, "Client pack").
# resource-pack-sha1: printed by the build and written to the zip's .sha1 file.
# A rebuild that changes the pack changes this; tests/test_server_client_pack.py
# fails if it differs from a built pack's .sha1.
# resource-pack-id: fixed, so clients treat a rebuilt pack as the same pack
# (uuid5 of URL namespace, "cobblers:client-pack/cobblers-client-AllTheMons-subset").
# resource-pack-prompt: a JSON text component (the server logs "Failed to parse
# resource pack prompt" otherwise); it carries the AllTheMons credit.
# require-resource-pack=true: a player who declines the pack is disconnected.
require-resource-pack=true
resource-pack=
resource-pack-sha1=dfdd4f8118a66ff854d23a1e5c2f7651ff042e97
resource-pack-id=43566b60-4e01-549a-95d3-2592c69f3454
resource-pack-prompt={"text":"Cobblers model pack: AllTheMons models (Lvnatic and contributors) and Cobblemon 1.8 fixes. Without it, some Pokemon render as dolls."}
# Datapacks are force-loaded by the Global Packs mod (config/global_packs.toml);
# initial-enabled-packs only matters for vanilla-registered packs.
initial-enabled-packs=vanilla
function-permission-level=2
op-permission-level=4

# --- gameplay requirements ----------------------------------------------
# REQUIRED, the owner 2026-10-02: the Necrozma towers (lift and summit chain)
# and Mew's temple door are command blocks. With false the towers have no way
# up and nothing fires. tools/install_check.py reports anything else as a
# PROPERTY problem. Do not turn it off.
enable-command-block=true
